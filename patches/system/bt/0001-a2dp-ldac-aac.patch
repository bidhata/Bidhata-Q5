+    for (index = 0; index < BTA_AV_CO_NUM_ELEMENTS(bta_av_co_cb.peers); index++)
+    {
+        tBTA_AV_CO_PEER *p_peer = &bta_av_co_cb.peers[index];
+        if (p_peer->opened)
+            APPL_TRACE_DEBUG("Bidhata get_ldac_config: peer %d opened mtu %d ldac_open %d p_snk %p snk_type 0x%02x cfg[%02x %02x %02x]",
+                           index, p_peer->mtu, index < sizeof(bidhata_peer_ldac_open) ? bidhata_peer_ldac_open[index] : -1,
+                           p_peer->p_snk, p_peer->p_snk ? p_peer->p_snk->codec_type : 0,
+                           p_peer->codec_cfg[0], p_peer->codec_cfg[1], p_peer->codec_cfg[2]);
+        if (p_peer->opened && index < sizeof(bidhata_peer_ldac_open) && bidhata_peer_ldac_open[index])
+        {
+            *p_mtu = p_peer->mtu;
+            result = TRUE;
+            break;
+        }
+    }
+    GKI_enable();
+    return result;
+}
+
+/*******************************************************************************
+ ** Bidhata: TRUE if an opened peer streams AAC; *p_mtu = media MTU, *p_bitrate from the config,
+ ** *p_mpeg2 = object type MPEG-2 AAC LC.
+ *******************************************************************************/
+BOOLEAN bta_av_co_audio_get_aac_config(UINT16 *p_mtu, UINT32 *p_bitrate, BOOLEAN *p_mpeg2)
+{
+    UINT8 index;
+    BOOLEAN result = FALSE;
+    GKI_disable();
+    for (index = 0; index < BTA_AV_CO_NUM_ELEMENTS(bta_av_co_cb.peers); index++)
+    {
+        tBTA_AV_CO_PEER *p_peer = &bta_av_co_cb.peers[index];
+        if (p_peer->opened && index < sizeof(bidhata_peer_ldac_open) &&
+            bidhata_peer_codec[index] == BTA_AV_CODEC_M24)
+        {
+            const UINT8 *c = bidhata_peer_cfg[index];
+            *p_mtu = p_peer->mtu;
+            *p_bitrate = bidhata_aac_bitrate(c);
+            *p_mpeg2 = (c[3] & 0x80) ? TRUE : FALSE;
+            APPL_TRACE_DEBUG("Bidhata get_aac_config: peer %d mtu %d cfg %02x %02x %02x %02x %02x %02x",
+                           index, p_peer->mtu, c[3], c[4], c[5], c[6], c[7], c[8]);
+            result = TRUE;
+            break;
+        }
+    }
+    GKI_enable();
+    return result;
+}
