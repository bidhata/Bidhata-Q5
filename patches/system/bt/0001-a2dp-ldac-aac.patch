+// Bidhata-Q5: the MediaTek BT library cannot read our NVRAM record, so the chip would come up
+// with MediaTek's default address on every unit. q5_nvram_mac.sh writes a per-unit address to
+// this file; hand it to the chip with MediaTek's "set local BD address" vendor command.
+#define Q5_BDADDR_FILE "/data/misc/bluedroid/bdaddr"
+#define HCI_MTK_SET_BD_ADDR 0xFC1A
+
+static void q5_bdaddr_complete(BT_HDR *response, UNUSED_ATTR void *context) {
+  buffer_allocator_get_interface()->free(response);
+}
+
+static void q5_bdaddr_status(uint8_t status, BT_HDR *command, UNUSED_ATTR void *context) {
+  LOG_WARN("%s set bd addr answered with status 0x%02x", __func__, status);
+  buffer_allocator_get_interface()->free(command);
+}
+
+static void q5_set_bdaddr(void) {
+  char text[32] = {0};
+  bt_bdaddr_t addr;
+  FILE *f = fopen(Q5_BDADDR_FILE, "r");
+  if (!f)
+    return;
+  if (!fgets(text, sizeof(text), f))
+    text[0] = 0;
+  fclose(f);
+  text[17] = 0;
+  if (!string_to_bdaddr(text, &addr))
+    return;
+
+  // the command wants the address least significant byte first
+  uint8_t le[6];
+  for (int i = 0; i < 6; i++)
+    le[i] = addr.address[5 - i];
+  // Not awaited: an unknown vendor command may only get a command status, which a future
+  // would never see. Commands go out in order, so it lands before READ_BD_ADDR below.
+  hci->transmit_command(packet_factory->make_vendor_command(HCI_MTK_SET_BD_ADDR, le, sizeof(le)),
+                        q5_bdaddr_complete, q5_bdaddr_status, NULL);
+  LOG_INFO("%s requested %s", __func__, text);
+}
+
