+/* ---- Bidhata: LDAC (vendor 0x0000012D, codec 0x00AA) ---- */
+#define BIDHATA_CT_VENDOR 0xFF
+static BOOLEAN bidhata_peer_ldac_open[BTA_AV_NUM_STRS + 2];   /* set in audio_open from the opened config */
+static UINT8 bidhata_peer_codec[BTA_AV_NUM_STRS + 2];          /* opened codec type (0 SBC, 2 AAC, 0xFF vendor) */
+static UINT8 bidhata_peer_cfg[BTA_AV_NUM_STRS + 2][AVDT_CODEC_SIZE];
+static BOOLEAN bidhata_is_ldac(const UINT8 *p_info)
+{
+    /* p_info[0]=LOSC [1]=media type [2]=codec type [3..6]=vendor id LE [7..8]=codec id LE */
+    return (p_info[0] >= 10) && (p_info[2] == BIDHATA_CT_VENDOR) &&
+           (p_info[3] == 0x2D) && (p_info[4] == 0x01) && (p_info[5] == 0) && (p_info[6] == 0) &&
+           (p_info[7] == 0xAA) && (p_info[8] == 0x00);
+}
+/* persist.bt.a2dp.codec: auto (default) | ldac | aac | sbc */
+static BOOLEAN bidhata_ldac_allowed(void)
+{
+    char v[PROPERTY_VALUE_MAX];
+    char seps[PROPERTY_VALUE_MAX];
+    property_get("persist.bt.a2dp.seps", seps, "sbc");
+    if (strcmp(seps, "all") != 0)
+        return FALSE;   /* LDAC SEP not registered */
+    property_get("persist.bt.a2dp.codec", v, "auto");
+    return (strcmp(v, "auto") == 0) || (strcmp(v, "ldac") == 0);
+}
+/* Returns TRUE and the sink index if the peer has an LDAC sink usable at 44.1 kHz stereo. */
+static BOOLEAN bidhata_peer_ldac_sink(tBTA_AV_CO_PEER *p_peer, UINT8 *p_index)
+{
+    UINT8 i;
+    if (!bidhata_ldac_allowed())
+        return FALSE;
+    for (i = 0; i < p_peer->num_sup_snks; i++)
+    {
+        const UINT8 *c = p_peer->snks[i].codec_caps;
+        if (p_peer->snks[i].codec_type == BIDHATA_CT_VENDOR && bidhata_is_ldac(c) &&
+            (c[9] & 0x20) && (c[10] & 0x01))
+        {
+            *p_index = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+static BOOLEAN bidhata_aac_allowed(void)
+{
+    char v[PROPERTY_VALUE_MAX];
+    char seps[PROPERTY_VALUE_MAX];
+    property_get("persist.bt.a2dp.seps", seps, "sbc");
+    if (strcmp(seps, "all") != 0)
+        return FALSE;
+    property_get("persist.bt.a2dp.codec", v, "auto");
+    return (strcmp(v, "auto") == 0) || (strcmp(v, "aac") == 0);
+}
+/* AAC element: [3] object type, [4] freq 8k..44.1k, [5] hi: 48k..96k lo: channels (0x08 mono, 0x04 stereo),
+ * [6] bit7 VBR + bitrate bits 22..16, [7..8] bitrate */
+static BOOLEAN bidhata_aac_caps_ok(const UINT8 *c)
+{
+    return (c[0] >= 8) && (c[2] == BTA_AV_CODEC_M24) && (c[3] & 0xC0) && (c[4] & 0x01) && (c[5] & 0x04);
+}
+static UINT32 bidhata_aac_bitrate(const UINT8 *c)
+{
+    return ((UINT32)(c[6] & 0x7F) << 16) | ((UINT32)c[7] << 8) | c[8];
+}
+static BOOLEAN bidhata_peer_aac_sink(tBTA_AV_CO_PEER *p_peer, UINT8 *p_index)
+{
+    UINT8 i;
+    if (!bidhata_aac_allowed())
+        return FALSE;
+    for (i = 0; i < p_peer->num_sup_snks; i++)
+    {
+        if (p_peer->snks[i].codec_type == BTA_AV_CODEC_M24 && bidhata_aac_caps_ok(p_peer->snks[i].codec_caps))
+        {
+            *p_index = i;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+static void bidhata_aac_build_config(const UINT8 *caps, UINT8 *p_cfg)
+{
+    UINT32 br = bidhata_aac_bitrate(caps);
+    if (br == 0 || br > 320000)
+        br = (br == 0) ? 256000 : 320000;
+    memset(p_cfg, 0, AVDT_CODEC_SIZE);
+    p_cfg[0] = 8;
+    p_cfg[1] = AVDT_MEDIA_AUDIO << 4;
+    p_cfg[2] = BTA_AV_CODEC_M24;
+    p_cfg[3] = (caps[3] & 0x80) ? 0x80 : 0x40;     /* MPEG-2 AAC LC preferred, else MPEG-4 AAC LC */
+    p_cfg[4] = 0x01;                               /* 44.1 kHz */
+    p_cfg[5] = 0x04;                               /* stereo */
+    p_cfg[6] = (UINT8)((br >> 16) & 0x7F);         /* CBR */
+    p_cfg[7] = (UINT8)(br >> 8);
+    p_cfg[8] = (UINT8)br;
+}
+/* SBC XQ: Dual Channel + high bitpool when the sink can take it. persist.bt.sbc.xq = 1 (default) | 0 */
+#define BIDHATA_SBC_XQ_MAX_BITPOOL 47   /* ~552 kbps at 44.1 kHz dual channel; higher is unsafe on this radio */
+#define BIDHATA_SBC_XQ_MIN_SINK_BP 38   /* below this, dual channel would sound worse than joint stereo */
+static BOOLEAN bidhata_sbc_xq_enabled(void)
+{
+    char v[PROPERTY_VALUE_MAX];
+    property_get("persist.bt.sbc.xq", v, "1");
+    return strcmp(v, "0") != 0;
+}
+static void bidhata_ldac_build_config(UINT8 *p_cfg)
+{
+    static const UINT8 cfg[] = {10, AVDT_MEDIA_AUDIO << 4, BIDHATA_CT_VENDOR,
+                                0x2D, 0x01, 0x00, 0x00, 0xAA, 0x00, 0x20 /* 44.1 */, 0x01 /* stereo */};
+    memset(p_cfg, 0, AVDT_CODEC_SIZE);
+    memcpy(p_cfg, cfg, sizeof(cfg));
+}
