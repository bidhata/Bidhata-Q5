+/*******************************************************************************
+ ** Bidhata: LDAC encoding
+ *******************************************************************************/
+static void bidhata_ldac_free(void)
+{
+    if (ldac_abr)
+    {
+        ldac_ABR_free_handle(ldac_abr);
+        ldac_abr = NULL;
+    }
+    if (ldac_h)
+    {
+        ldacBT_free_handle(ldac_h);
+        ldac_h = NULL;
+    }
+}
+
+static void bidhata_ldac_reinit(void)
+{
+    int err;
+    if (ldac_h == NULL)
+        ldac_h = ldacBT_get_handle();
+    else
+        ldacBT_close_handle(ldac_h);
+    if (ldac_h == NULL)
+    {
+        APPL_TRACE_ERROR("Bidhata LDAC: get_handle failed, falling back to SBC");
+        btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_SBC;
+        return;
+    }
+    err = ldacBT_init_handle_encode(ldac_h, ldac_mtu, ldac_eqmid, LDACBT_CHANNEL_MODE_STEREO,
+                                    LDACBT_SMPL_FMT_S16, 44100);
+    if (err)
+    {
+        APPL_TRACE_ERROR("Bidhata LDAC: init_handle_encode(mtu %d eqmid %d) failed err %d api %d",
+                         ldac_mtu, ldac_eqmid, err, ldacBT_get_error_code(ldac_h));
+        bidhata_ldac_free();
+        btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_SBC;
+        return;
+    }
+    if (ldac_use_abr)
+    {
+        if (ldac_abr == NULL)
+            ldac_abr = ldac_ABR_get_handle();
+        if (ldac_abr == NULL || ldac_ABR_Init(ldac_abr, BTIF_MEDIA_TIME_TICK) != 0)
+        {
+            APPL_TRACE_ERROR("Bidhata LDAC: ABR init failed, fixed eqmid");
+            if (ldac_abr) { ldac_ABR_free_handle(ldac_abr); ldac_abr = NULL; }
+        }
+    }
+    APPL_TRACE_WARNING("Bidhata LDAC: encoder ready mtu %d eqmid %d bitrate %d kbps abr %d",
+                       ldac_mtu, ldac_eqmid, ldacBT_get_bitrate(ldac_h), ldac_abr != NULL);
+    /* tell the UI what is on air (the Bidhata launcher shows it) */
+    property_set("bluetooth.a2dp.codec", ldac_abr ? "LDAC ABR" : "LDAC");
+}
+
+/* Called after feeding init: switch to LDAC if the stream was configured for LDAC. */
+static void bidhata_ldac_check(void)
+{
+    UINT16 mtu = 0;
+    char q[PROPERTY_VALUE_MAX];
+
+    APPL_TRACE_WARNING("Bidhata LDAC: check (feeding %d Hz)", btif_media_cb.media_feeding.cfg.pcm.sampling_freq);
+    if (!bta_av_co_audio_get_ldac_config(&mtu))
+    {
+        APPL_TRACE_WARNING("Bidhata LDAC: stream is not LDAC -> SBC");
+        bidhata_ldac_free();
+        return;
+    }
+    if (btif_media_cb.media_feeding.cfg.pcm.sampling_freq != 44100 ||
+        btif_media_cb.media_feeding.cfg.pcm.num_channel != 2 ||
+        btif_media_cb.media_feeding.cfg.pcm.bit_per_sample != 16)
+    {
+        APPL_TRACE_ERROR("Bidhata LDAC: unsupported PCM feeding %d/%d/%d",
+                         btif_media_cb.media_feeding.cfg.pcm.sampling_freq,
+                         btif_media_cb.media_feeding.cfg.pcm.num_channel,
+                         btif_media_cb.media_feeding.cfg.pcm.bit_per_sample);
+        return;
+    }
+    /* hq | sq | mq fixed; abr (default) starts at HQ and adapts to the link */
+    property_get("persist.bt.ldac.quality", q, "abr");
+    ldac_use_abr = FALSE;
+    if (!strcmp(q, "hq")) ldac_eqmid = LDACBT_EQMID_HQ;
+    else if (!strcmp(q, "sq")) ldac_eqmid = LDACBT_EQMID_SQ;
+    else if (!strcmp(q, "mq")) ldac_eqmid = LDACBT_EQMID_MQ;
+    else { ldac_eqmid = LDACBT_EQMID_HQ; ldac_use_abr = TRUE; }
+    /* bta reports the media MTU without the 12-byte RTP header; libldac wants the L2CAP MTU
+     * (it subtracts RTP + 1-byte payload header itself and requires >= 679). */
+    mtu += AVDT_MEDIA_HDR_SIZE;
+    /* largest packet must fit the AA buffer too */
+    if (mtu > BTIF_MEDIA_AA_BUF_SIZE - BTIF_MEDIA_AA_SBC_OFFSET - sizeof(BT_HDR))
+        mtu = BTIF_MEDIA_AA_BUF_SIZE - BTIF_MEDIA_AA_SBC_OFFSET - sizeof(BT_HDR);
+    ldac_mtu = mtu;
+    btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_LDAC;
+    ldac_pkts = ldac_underruns = ldac_drops = 0;
+    bidhata_ldac_reinit();
+}
+
+static void bidhata_ldac_enqueue(const UINT8 *data, int len, int frames)
+{
+    BT_HDR *p_buf;
+    if (btif_media_cb.tx_flush)
+    {
+        if (GKI_queue_length(&btif_media_cb.TxAaQ) > 0)
+            btif_media_flush_q(&(btif_media_cb.TxAaQ));
+        return;
+    }
+    while (GKI_queue_length(&btif_media_cb.TxAaQ) >= LDAC_MAX_TXQ)
+    {
+        GKI_freebuf(GKI_dequeue(&(btif_media_cb.TxAaQ)));
+        ldac_drops++;
+    }
+    if (NULL == (p_buf = GKI_getpoolbuf(BTIF_MEDIA_AA_POOL_ID)))
+    {
+        APPL_TRACE_ERROR("Bidhata LDAC: no buffer (TxAaQ %d)", GKI_queue_length(&btif_media_cb.TxAaQ));
+        return;
+    }
+    p_buf->offset = BTIF_MEDIA_AA_SBC_OFFSET;
+    p_buf->len = len;
+    p_buf->layer_specific = frames;
+    memcpy((UINT8 *)(p_buf + 1) + p_buf->offset, data, len);
+    *((UINT32 *)(p_buf + 1)) = btif_media_cb.timestamp;
+    GKI_enqueue(&(btif_media_cb.TxAaQ), p_buf);
+    if ((++ldac_pkts % 2000) == 0)
+        APPL_TRACE_WARNING("Bidhata LDAC: %u pkts, %u underruns, %u drops, bitrate %d, q %d",
+                           ldac_pkts, ldac_underruns, ldac_drops, ldacBT_get_bitrate(ldac_h),
+                           GKI_queue_length(&btif_media_cb.TxAaQ));
+}
+
+/* One 20 ms tick: encode the PCM due and queue finished LDAC packets. */
+static void bidhata_ldac_send(void)
+{
+    static UINT8 pcm[LDAC_PCM_CHUNK];
+    static UINT8 out[1024];
+    UINT32 us_this_tick = BTIF_MEDIA_TIME_TICK * 1000;
+    UINT64 now_us = time_now_us();
+    UINT32 chunks;
+    UINT16 event;
+
+    if (ldac_h == NULL)
+        return;
+    if (ldac_abr)
+    {
+        int before = ldacBT_get_eqmid(ldac_h);
+        ldac_ABR_Proc(ldac_h, ldac_abr, GKI_queue_length(&btif_media_cb.TxAaQ), 1);
+        if (ldacBT_get_eqmid(ldac_h) != before)
+            APPL_TRACE_WARNING("Bidhata LDAC: ABR eqmid %d -> %d (q %d) bitrate %d",
+                               before, ldacBT_get_eqmid(ldac_h), GKI_queue_length(&btif_media_cb.TxAaQ),
+                               ldacBT_get_bitrate(ldac_h));
+    }
+    if (last_frame_us != 0)
+        us_this_tick = (now_us - last_frame_us);
+    last_frame_us = now_us;
+    btif_media_cb.media_feeding_state.pcm.counter +=
+        btif_media_cb.media_feeding_state.pcm.bytes_per_tick * us_this_tick / (BTIF_MEDIA_TIME_TICK * 1000);
+    chunks = btif_media_cb.media_feeding_state.pcm.counter / LDAC_PCM_CHUNK;
+    if (chunks > 40)    /* cap catch-up after a stall (~116 ms) */
+        chunks = 40;
+    btif_media_cb.media_feeding_state.pcm.counter -= chunks * LDAC_PCM_CHUNK;
+
+    while (chunks--)
+    {
+        int used = 0, written = 0, frames = 0;
+        UINT32 n = UIPC_Read(UIPC_CH_ID_AV_AUDIO, &event, pcm, LDAC_PCM_CHUNK);
+        if (n < LDAC_PCM_CHUNK)
+        {
+            ldac_underruns++;
+            if (n == 0)
+            {
+                /* nothing to read: give the time back and stop for this tick */
+                btif_media_cb.media_feeding_state.pcm.counter += (chunks + 1) * LDAC_PCM_CHUNK;
+                return;
+            }
+            memset(pcm + n, 0, LDAC_PCM_CHUNK - n);
+        }
+        if (ldacBT_encode(ldac_h, pcm, &used, out, &written, &frames) < 0)
+        {
+            APPL_TRACE_ERROR("Bidhata LDAC: encode error %d, re-init", ldacBT_get_error_code(ldac_h));
+            bidhata_ldac_reinit();
+            return;
+        }
+        if (written > 0)
+            bidhata_ldac_enqueue(out, written, frames);
+        btif_media_cb.timestamp += LDACBT_ENC_LSU;
+    }
+}
+
+/*******************************************************************************
+ ** Bidhata: AAC encoding (FDK-AAC, AAC-LC, LATM MCP1, 1 frame per packet, no payload header)
+ *******************************************************************************/
+static void bidhata_aac_free(void)
+{
+    if (aac_h)
+    {
+        aacEncClose(&aac_h);
+        aac_h = NULL;
+    }
+}
+
+static void bidhata_aac_reinit(void)
+{
+    AACENC_ERROR e;
+    AACENC_InfoStruct info;
+    UINT32 max_br;
+
+    bidhata_aac_free();
+    if ((e = aacEncOpen(&aac_h, 0, 2)) != AACENC_OK)
+    {
+        APPL_TRACE_ERROR("Bidhata AAC: aacEncOpen err 0x%x, SBC fallback", e);
+        aac_h = NULL;
+        btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_SBC;
+        return;
+    }
+    /* keep the average frame well inside the MTU (no peak-bitrate control in this FDK).
+     * 75% gave ~0.5% frames > MTU (dropped) on the Huawei; default 66%, tunable 50..90. */
+    {
+        char pct_s[PROPERTY_VALUE_MAX];
+        int pct;
+        property_get("persist.bt.aac.mtu_pct", pct_s, "66");
+        pct = atoi(pct_s);
+        if (pct < 50 || pct > 90) pct = 66;
+        max_br = (UINT32)(aac_mtu * 8 * pct / 100) * 44100 / AAC_FRAME_SAMPLES;
+    }
+    if (aac_bitrate == 0) aac_bitrate = 256000;
+    if (aac_bitrate > max_br) aac_bitrate = max_br;
+    if (aacEncoder_SetParam(aac_h, AACENC_AOT, aac_mpeg2 ? AOT_MP2_AAC_LC : AOT_AAC_LC) != AACENC_OK &&
+        aacEncoder_SetParam(aac_h, AACENC_AOT, AOT_AAC_LC) != AACENC_OK)
+        APPL_TRACE_ERROR("Bidhata AAC: set AOT failed");
+    aacEncoder_SetParam(aac_h, AACENC_SAMPLERATE, 44100);
+    aacEncoder_SetParam(aac_h, AACENC_CHANNELMODE, MODE_2);
+    aacEncoder_SetParam(aac_h, AACENC_CHANNELORDER, 1);
+    aacEncoder_SetParam(aac_h, AACENC_BITRATEMODE, 0);           /* CBR */
+    aacEncoder_SetParam(aac_h, AACENC_BITRATE, aac_bitrate);
+    aacEncoder_SetParam(aac_h, AACENC_TRANSMUX, TT_MP4_LATM_MCP1);
+    aacEncoder_SetParam(aac_h, AACENC_HEADER_PERIOD, 1);
+    aacEncoder_SetParam(aac_h, AACENC_AFTERBURNER, 1);
+    if ((e = aacEncEncode(aac_h, NULL, NULL, NULL, NULL)) != AACENC_OK ||
+        aacEncInfo(aac_h, &info) != AACENC_OK)
+    {
+        APPL_TRACE_ERROR("Bidhata AAC: encoder init err 0x%x, SBC fallback", e);
+        bidhata_aac_free();
+        btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_SBC;
+        return;
+    }
+    property_set("bluetooth.a2dp.codec", "AAC");
+    APPL_TRACE_WARNING("Bidhata AAC: encoder ready mtu %d bitrate %u %s frame %d maxout %d",
+                       aac_mtu, aac_bitrate, aac_mpeg2 ? "MPEG-2" : "MPEG-4", info.frameLength, info.maxOutBufBytes);
+}
+
+static void bidhata_aac_check(void)
+{
+    UINT16 mtu = 0;
+    UINT32 br = 0;
+    BOOLEAN mpeg2 = TRUE;
+
+    if (!bta_av_co_audio_get_aac_config(&mtu, &br, &mpeg2))
+    {
+        bidhata_aac_free();
+        return;
+    }
+    if (btif_media_cb.media_feeding.cfg.pcm.sampling_freq != 44100 ||
+        btif_media_cb.media_feeding.cfg.pcm.num_channel != 2 ||
+        btif_media_cb.media_feeding.cfg.pcm.bit_per_sample != 16)
+    {
+        APPL_TRACE_ERROR("Bidhata AAC: unsupported PCM feeding");
+        return;
+    }
+    if (mtu > BTIF_MEDIA_AA_BUF_SIZE - BTIF_MEDIA_AA_SBC_OFFSET - sizeof(BT_HDR))
+        mtu = BTIF_MEDIA_AA_BUF_SIZE - BTIF_MEDIA_AA_SBC_OFFSET - sizeof(BT_HDR);
+    aac_mtu = mtu;              /* media payload limit (RTP header excluded, no payload header) */
+    aac_bitrate = br;
+    aac_mpeg2 = mpeg2;
+    aac_pkts = aac_underruns = aac_drops = aac_oversize = 0;
+    btif_media_cb.TxTranscoding = BTIF_MEDIA_TRSCD_PCM_2_AAC;
+    bidhata_aac_reinit();
+}
+
+static void bidhata_aac_send(void)
+{
+    static INT16 pcm[AAC_FRAME_SAMPLES * 2];
+    static UINT8 out[2048];
+    UINT32 us_this_tick = BTIF_MEDIA_TIME_TICK * 1000;
+    UINT64 now_us = time_now_us();
+    UINT32 frames;
+    UINT16 event;
+
+    if (aac_h == NULL)
+        return;
+    if (last_frame_us != 0)
+        us_this_tick = (now_us - last_frame_us);
+    last_frame_us = now_us;
+    btif_media_cb.media_feeding_state.pcm.counter +=
+        btif_media_cb.media_feeding_state.pcm.bytes_per_tick * us_this_tick / (BTIF_MEDIA_TIME_TICK * 1000);
+    frames = btif_media_cb.media_feeding_state.pcm.counter / AAC_PCM_FRAME;
+    if (frames > 5)
+        frames = 5;
+    btif_media_cb.media_feeding_state.pcm.counter -= frames * AAC_PCM_FRAME;
+
+    while (frames--)
+    {
+        AACENC_BufDesc in_desc, out_desc;
+        AACENC_InArgs in_args;
+        AACENC_OutArgs out_args;
+        void *in_ptr = pcm, *out_ptr = out;
+        INT in_id = IN_AUDIO_DATA, in_size = AAC_PCM_FRAME, in_el = 2;
+        INT out_id = OUT_BITSTREAM_DATA, out_size = sizeof(out), out_el = 1;
+        AACENC_ERROR e;
+        BT_HDR *p_buf;
+        UINT32 n = UIPC_Read(UIPC_CH_ID_AV_AUDIO, &event, (UINT8 *)pcm, AAC_PCM_FRAME);
+
+        if (n < AAC_PCM_FRAME)
+        {
+            aac_underruns++;
+            if (n == 0)
+            {
+                btif_media_cb.media_feeding_state.pcm.counter += (frames + 1) * AAC_PCM_FRAME;
+                return;
+            }
+            memset((UINT8 *)pcm + n, 0, AAC_PCM_FRAME - n);
+        }
+        in_desc.numBufs = 1; in_desc.bufs = &in_ptr; in_desc.bufferIdentifiers = &in_id;
+        in_desc.bufSizes = &in_size; in_desc.bufElSizes = &in_el;
+        out_desc.numBufs = 1; out_desc.bufs = &out_ptr; out_desc.bufferIdentifiers = &out_id;
+        out_desc.bufSizes = &out_size; out_desc.bufElSizes = &out_el;
+        in_args.numInSamples = AAC_FRAME_SAMPLES * 2;
+        in_args.numAncBytes = 0;
+        memset(&out_args, 0, sizeof(out_args));
+        e = aacEncEncode(aac_h, &in_desc, &out_desc, &in_args, &out_args);
+        btif_media_cb.timestamp += AAC_FRAME_SAMPLES;
+        if (e != AACENC_OK)
+        {
+            APPL_TRACE_ERROR("Bidhata AAC: encode err 0x%x", e);
+            continue;
+        }
+        if (out_args.numOutBytes <= 0)
+            continue;
+        if (out_args.numOutBytes > aac_mtu)
+        {
+            aac_oversize++;
+            continue;
+        }
+        if (btif_media_cb.tx_flush)
+        {
+            if (GKI_queue_length(&btif_media_cb.TxAaQ) > 0)
+                btif_media_flush_q(&(btif_media_cb.TxAaQ));
+            continue;
+        }
+        while (GKI_queue_length(&btif_media_cb.TxAaQ) >= 18)    /* ~400 ms of AAC frames */
+        {
+            GKI_freebuf(GKI_dequeue(&(btif_media_cb.TxAaQ)));
+            aac_drops++;
+        }
+        if (NULL == (p_buf = GKI_getpoolbuf(BTIF_MEDIA_AA_POOL_ID)))
+            continue;
+        p_buf->offset = BTIF_MEDIA_AA_SBC_OFFSET;
+        p_buf->len = out_args.numOutBytes;
+        p_buf->layer_specific = 1;
+        memcpy((UINT8 *)(p_buf + 1) + p_buf->offset, out, out_args.numOutBytes);
+        *((UINT32 *)(p_buf + 1)) = btif_media_cb.timestamp - AAC_FRAME_SAMPLES;
+        GKI_enqueue(&(btif_media_cb.TxAaQ), p_buf);
+        if ((++aac_pkts % 1000) == 0)
+            APPL_TRACE_WARNING("Bidhata AAC: %u pkts, %u underruns, %u drops, %u oversize, q %d",
+                               aac_pkts, aac_underruns, aac_drops, aac_oversize, GKI_queue_length(&btif_media_cb.TxAaQ));
+    }
+}
+
