+// The Q5's stock MediaTek lk does not pass androidboot.hardware, and since M init no longer
+// reads /proc/cpuinfo itself, ro.hardware would end up "unknown" (no init.<hw>.rc, no fstab).
+// Fall back to the "Hardware" line of /proc/cpuinfo, lower-cased, like older init did.
+static void hardware_from_cpuinfo() {
+    char value[PROP_VALUE_MAX];
+    if (property_get("ro.boot.hardware", value) > 0) return;
+    std::string cpuinfo;
+    if (!android::base::ReadFileToString("/proc/cpuinfo", &cpuinfo)) return;
+    size_t pos = cpuinfo.find("\nHardware");
+    if (pos == std::string::npos) return;
+    pos = cpuinfo.find(':', pos);
+    if (pos == std::string::npos) return;
+    pos++;
+    while (pos < cpuinfo.size() && (cpuinfo[pos] == ' ' || cpuinfo[pos] == '\t')) pos++;
+    std::string hw;
+    while (pos < cpuinfo.size() && cpuinfo[pos] != '\n' && !isspace(cpuinfo[pos])) {
+        hw += tolower(cpuinfo[pos]);
+        pos++;
+    }
+    if (!hw.empty()) {
+        NOTICE("ro.boot.hardware not set by the bootloader, using '%s' from /proc/cpuinfo\n", hw.c_str());
+        property_set("ro.boot.hardware", hw.c_str());
+    }
+}
+
 static void export_kernel_boot_props() {
+    hardware_from_cpuinfo();
     struct {
         const char *src_prop;
         const char *dst_prop;
