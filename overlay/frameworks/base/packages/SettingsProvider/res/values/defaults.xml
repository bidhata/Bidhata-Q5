<?xml version="1.0" encoding="utf-8"?>
<!-- Bidhata-Q5 first-boot defaults chosen for battery life on a music player. -->
<resources>
    <!-- no GPS driver on this unit: keep location off -->
    <string name="def_location_providers_allowed" translatable="false"></string>
    <!-- Wi-Fi stays up with the screen off (no stop/start churn); it just scans rarely -->
    <integer name="def_wifi_sleep_policy">2</integer>
    <integer name="def_screen_brightness">140</integer>
    <!-- no "open networks nearby" notification (it costs extra scans) -->
    <bool name="def_networks_available_notification_on">false</bool>
</resources>
