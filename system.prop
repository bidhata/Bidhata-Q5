# Bidhata-Q5 system properties
ro.sf.lcd_density=240
ro.sf.hwrotation=0
ro.opengles.version=131072
ro.mediatek.platform=MT6582
ro.mediatek.chip_ver=S01
ro.mtk_wlan_support=1
ro.mtk_bt_support=1
mediatek.wlan.chip=CONSYS_MT6582
mediatek.wlan.module.postfix=_consys_mt6582
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.tethering.interface=ap0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
dalvik.vm.isa.arm.features=div
ro.kernel.zio=38,108,105,16
# No telephony on this device
ro.radio.noril=yes
ro.carrier=wifi-only
# Bluetooth A2DP codecs (Bidhata 0.2): advertise LDAC+AAC+SBC; auto = LDAC > AAC > SBC; LDAC adaptive bitrate
persist.bt.a2dp.seps=all
persist.bt.a2dp.codec=auto
persist.bt.ldac.quality=abr

# Per-unit Bluetooth address written at boot by q5_nvram_mac.sh
ro.bt.bdaddr_path=/data/misc/bluedroid/bdaddr

