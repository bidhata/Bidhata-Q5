<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:fontFamily="sans-serif-light" />

    <LinearLayout
        android:id="@+id/share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_bg"
        android:stateListAnimator="@animator/press"
        android:padding="14dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/a_wifi" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
            android:id="@+id/share_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_off"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/share_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/share_hint"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:fontFamily="sans-serif-light" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bootname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:background="@drawable/tile_bg"
        android:stateListAnimator="@animator/press"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/bootname_title"
            android:textColor="@color/text"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/bootname_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <TextView
        android:id="@+id/power_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/tile_bg"
        android:stateListAnimator="@animator/press"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/power_title"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:numColumns="4"
        android:verticalSpacing="10dp"
        android:stretchMode="columnWidth"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
