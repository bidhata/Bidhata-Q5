<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:background="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/ae_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/text" android:textSize="15sp" />
    <TextView android:id="@+id/ae_source"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/text_dim" android:textSize="11sp" android:fontFamily="sans-serif-light" />
</LinearLayout>
