<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sound"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:fontFamily="sans-serif-light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/tile_bg"
        android:padding="12dp">
        <TextView
            android:id="@+id/ae_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp" />
        <RadioGroup
            android:id="@+id/ae_output"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <RadioButton android:id="@+id/ae_wired" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/ae_wired"
                android:textColor="@color/text" android:textSize="13sp" />
            <RadioButton android:id="@+id/ae_bt" android:layout_width="0dp" android:layout_weight="1.2"
                android:layout_height="wrap_content" android:text="@string/ae_bt"
                android:textColor="@color/text" android:textSize="13sp" />
            <RadioButton android:id="@+id/ae_speaker" android:layout_width="0dp" android:layout_weight="1.1"
                android:layout_height="wrap_content" android:text="@string/ae_speaker"
                android:textColor="@color/text" android:textSize="13sp" />
        </RadioGroup>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ae_off"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/ae_off"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:background="@drawable/tile_bg" />
            <TextView
                android:id="@+id/ae_advanced"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:text="@string/ae_advanced"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:background="@drawable/tile_bg" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/bt_codec" android:textColor="@color/text" android:textSize="14sp" />
        <Spinner
            android:id="@+id/bt_codec"
            android:layout_width="150dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/ldac_quality" android:textColor="@color/text" android:textSize="14sp" />
        <Spinner
            android:id="@+id/ldac_quality"
            android:layout_width="150dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Switch
        android:id="@+id/wired_bt"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/wired_bt"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ae_query"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:hint="@string/ae_hint"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/ae_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/ae_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="#14FFFFFF"
        android:dividerHeight="1dp" />
</LinearLayout>
