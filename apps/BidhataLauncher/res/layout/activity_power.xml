<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/power_title"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:fontFamily="serif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/tile_bg"
        android:padding="14dp">
        <Switch android:id="@+id/pw_off_switch"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:text="@string/power_off_at" android:textColor="@color/text" android:textSize="15sp" />
        <TextView android:id="@+id/pw_off_time"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical"
            android:textColor="@color/accent" android:textSize="30sp" android:fontFamily="serif"
            android:background="?android:attr/selectableItemBackground" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#14FFFFFF" />
        <Switch android:id="@+id/pw_on_switch"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:text="@string/power_on_at" android:textColor="@color/text" android:textSize="15sp" />
        <TextView android:id="@+id/pw_on_time"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical"
            android:textColor="@color/accent" android:textSize="30sp" android:fontFamily="serif"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/power_hint"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <TextView android:id="@+id/pw_modules"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="@drawable/tile_bg"
        android:text="@string/modules_title"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <!-- For updates: restart straight into TWRP, no PC needed -->
    <TextView android:id="@+id/pw_recovery"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="@drawable/tile_bg"
        android:text="@string/power_recovery"
        android:textColor="@color/text"
        android:textSize="15sp" />
</LinearLayout>
</ScrollView>
