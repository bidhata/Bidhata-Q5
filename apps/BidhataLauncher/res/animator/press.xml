<?xml version="1.0" encoding="utf-8"?>
<!-- tiles sink slightly under the finger; runs on the render thread -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.965" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.965" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="180" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="180" android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
