<?xml version="1.0" encoding="utf-8"?>
<!-- Bidhata Recorder, same look as the home screen: big thin timer, one card of options. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/zero_time"
        android:textColor="@color/text"
        android:textSize="54sp"
        android:fontFamily="sans-serif-thin"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/level"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="#33FFFFFF"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="18dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />

    <ImageButton
        android:id="@+id/record"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/app_name"
        android:background="@drawable/rec_button"
        android:src="@drawable/ic_mic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/card"
        android:paddingLeft="14dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <RadioGroup
            android:id="@+id/fmt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <RadioButton android:id="@+id/fmt_wav" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/fmt_wav"
                android:checked="true" android:textColor="@color/text" android:textSize="14sp" />
            <RadioButton android:id="@+id/fmt_aac" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/fmt_aac"
                android:textColor="@color/text" android:textSize="14sp" />
        </RadioGroup>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14FFFFFF" />
        <Switch
            android:id="@+id/stereo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/stereo"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/recordings"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <ListView
        android:id="@+id/files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="#14FFFFFF"
        android:dividerHeight="1dp" />
</LinearLayout>
